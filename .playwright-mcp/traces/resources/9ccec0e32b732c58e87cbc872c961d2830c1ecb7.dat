function grcl(){let t=0,n=[function n(){t++,n()},function n(c){t++,c(c)},function n(c,i){t+=i,c(c,1)},function n(c,i,l){t=t+l-i,c(c,1,2)},function n(c,i,l,o){t=t+o-l-i,c(c,1,2,4)},function n(c,i,l,o,f){t=t+f-o-l-i,c(c,1,2,4,8)}];function c(){t++,c.call(this)}let i=[c,function n(c){t++,c.call(this,c)},function n(c,i){t+=i,c.call(this,c,1)},function n(c,i,l){t=t+l-i,c.call(this,c,1,2)},function n(c,i,l,o){t=t+o-l-i,c.call(this,c,1,2,4)},function n(c,i,l,o,f){t=t+f-o-l-i,c.call(this,c,1,2,4,8)}];function l(n){let c=[];for(let i=0;i<n.length;i++){let l=n[i];try{t=0,l(l,1,2,4,8)}catch(o){c[i]=t}}return c}let o=l(n),f=l(i);return{r:o,c:f}}try{var t=grcl();self.postMessage(JSON.stringify(t))}catch(n){self.postMessage(-1)};